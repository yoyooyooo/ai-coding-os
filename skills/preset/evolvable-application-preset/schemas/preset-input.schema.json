{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evolvable Application Profile Selection",
  "type": "object",
  "required": ["schema_version", "profiles"],
  "properties": {
    "schema_version": {"const": 1},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
