{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resolved Project Naming Vocabulary",
  "type": "object",
  "required": [
    "schema_version",
    "preset_snapshot",
    "contract_selection",
    "syntax",
    "canonical_terms",
    "canonical_qualifiers",
    "filename_patterns",
    "guarded_terms",
    "project_terms"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "preset_snapshot": {
      "type": "object"
    },
    "contract_selection": {
      "type": "object",
      "required": ["term_owners", "extra_terms", "filename_pattern_owners", "guarded_terms", "qualifiers"],
      "properties": {
        "term_owners": {"type": "array", "items": {"type": "string"}},
        "extra_terms": {"type": "array", "items": {"type": "string"}},
        "filename_pattern_owners": {"type": "array", "items": {"type": "string"}},
        "guarded_terms": {"type": "array", "items": {"type": "string"}},
        "qualifiers": {"type": "object"}
      },
      "additionalProperties": false
    },
    "syntax": {
      "type": "object"
    },
    "canonical_terms": {
      "type": "object"
    },
    "filename_patterns": {
      "type": "array"
    },
    "directory_admission": {
      "type": "array"
    },
    "promotion_ladder": {
      "type": "array"
    },
    "guarded_terms": {
      "type": "object"
    },
    "project_terms": {
      "description": "Source naming mappings that reference the project SSoT for meaning instead of redefining product language.",
      "type": "object"
    },
    "implementation_qualifiers": {
      "type": "object"
    },
    "deprecated_terms": {
      "type": "object"
    },
    "canonical_qualifiers": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
