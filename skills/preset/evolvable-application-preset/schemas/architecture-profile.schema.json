{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architecture Profile Snapshot",
  "type": "object",
  "required": ["schema_version", "preset", "profiles", "profile_resolution", "decisions", "resolved_standards"],
  "properties": {
    "schema_version": {"const": 1},
    "preset": {
      "type": "object",
      "required": ["id", "version", "mode"],
      "properties": {
        "id": {"const": "evolvable-application"},
        "version": {"type": "string"},
        "mode": {"enum": ["candidate-snapshot", "resolved-snapshot"]}
      }
    },
    "profiles": {"type": "array", "items": {"type": "string"}},
    "profile_resolution": {
      "type": "object",
      "required": ["requested", "dependency_added", "resolved"],
      "properties": {
        "requested": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "defaults_added": {"description": "System defaults added by current writers; absent only in legacy snapshots.", "type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "dependency_added": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "resolved": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "decisions": {
      "type": "object",
      "properties": {
        "docs_shape": {"const": "earned-semantic-layers"}
      }
    },
    "resolved_standards": {"type": "object"},
    "enforcement": {"type": "object"},
    "exceptions": {"type": "array"}
  },
  "additionalProperties": true
}
