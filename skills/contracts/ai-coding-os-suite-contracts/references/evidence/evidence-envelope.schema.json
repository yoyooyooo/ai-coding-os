{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Coding OS Claim-Bounded Evidence Envelope",
  "description": "Optional bounded evidence passed between owner-local systems. Version 2 is direction-neutral; the receiving owner decides classification and sufficiency. Version 1 remains readable for finite compatibility.",
  "oneOf": [
    {
      "$ref": "#/$defs/v1"
    },
    {
      "$ref": "#/$defs/v2"
    }
  ],
  "$defs": {
    "v1": {
      "title": "Legacy directional Evidence Envelope reader",
      "type": "object",
      "required": [
        "schema_version",
        "translation",
        "source_ref",
        "claim_ceiling",
        "observed",
        "supports",
        "not_proven",
        "evidence_refs",
        "verification_level"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "translation": {
          "enum": [
            "harness_to_execution",
            "product_to_docs",
            "harness_to_docs",
            "execution_to_docs"
          ]
        },
        "source_ref": {
          "type": "object",
          "required": [
            "kind",
            "ref"
          ],
          "properties": {
            "kind": {
              "enum": [
                "harness_result",
                "product_decision",
                "execution_evidence"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        },
        "observed": {
          "type": "object"
        },
        "supports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "not_proven": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification_level": {
          "type": "string",
          "minLength": 1
        },
        "proof_surface": {
          "$ref": "../proof/proof-surface.schema.json"
        },
        "target_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "translation": {
                "const": "harness_to_execution"
              }
            }
          },
          "then": {
            "properties": {
              "source_ref": {
                "properties": {
                  "kind": {
                    "const": "harness_result"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "translation": {
                "const": "product_to_docs"
              }
            }
          },
          "then": {
            "properties": {
              "source_ref": {
                "properties": {
                  "kind": {
                    "const": "product_decision"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "translation": {
                "const": "harness_to_docs"
              }
            }
          },
          "then": {
            "properties": {
              "source_ref": {
                "properties": {
                  "kind": {
                    "const": "harness_result"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "translation": {
                "const": "execution_to_docs"
              }
            }
          },
          "then": {
            "properties": {
              "source_ref": {
                "properties": {
                  "kind": {
                    "const": "execution_evidence"
                  }
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "v2": {
      "title": "Direction-neutral Evidence Envelope writer",
      "type": "object",
      "required": [
        "schema_version",
        "source_ref",
        "claim_ceiling",
        "observed",
        "supports",
        "not_proven",
        "evidence_refs"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        },
        "observed": {
          "type": "object"
        },
        "supports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "not_proven": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "proof_surface": {
          "$ref": "../proof/proof-surface.schema.json"
        }
      },
      "additionalProperties": false
    }
  }
}
