{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Coding OS Skill Eval File",
  "type": "object",
  "required": [
    "schema_version",
    "skill_name",
    "evals"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "skill_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "evals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "prompt",
          "expected_output"
        ],
        "properties": {
          "id": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "expected_output": {
            "type": "string",
            "minLength": 1
          },
          "expectations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
