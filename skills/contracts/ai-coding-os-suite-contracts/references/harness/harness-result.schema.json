{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Result",
  "type": "object",
  "required": [
    "schema_version",
    "harness",
    "status",
    "observed",
    "supports",
    "not_proven"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "harness": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "blocked",
        "skipped",
        "unstable-pass"
      ]
    },
    "proof_surface": {
      "$ref": "../proof/proof-surface.schema.json"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "observed": {
      "type": "object"
    },
    "supports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "not_proven": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_level": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environment": {
      "description": "Deprecated free-form v1 environment field.",
      "deprecated": true,
      "type": "string"
    },
    "command": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object"
          }
        ]
      }
    },
    "provenance": {
      "type": "object"
    },
    "does_not_decide": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "proof_surface",
          "claim_ceiling"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "environment"
              ]
            },
            {
              "required": [
                "proofSurface"
              ]
            },
            {
              "required": [
                "claimCeiling"
              ]
            },
            {
              "required": [
                "notProven"
              ]
            },
            {
              "required": [
                "evidenceRefs"
              ]
            },
            {
              "required": [
                "verificationLevel"
              ]
            }
          ]
        }
      }
    }
  ],
  "additionalProperties": true
}
