{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Descriptor",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "capability",
    "command",
    "can_observe",
    "does_not_cover"
  ],
  "properties": {
    "schema_version": {
      "enum": [1, 2]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "surface": {
      "description": "Deprecated v1 surface field.",
      "deprecated": true,
      "enum": [
        "headless",
        "interface-headless",
        "render",
        "browser",
        "external-runtime"
      ]
    },
    "proof_surface": {
      "$ref": "../proof/proof-surface.schema.json"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "uses": {
      "type": "object"
    },
    "can_observe": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "does_not_cover": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_ceiling": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {"const": 1}
        }
      },
      "then": {
        "required": ["surface"]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": 2}
        }
      },
      "then": {
        "required": ["proof_surface", "claim_ceiling"],
        "not": {
          "anyOf": [
            {"required": ["surface"]},
            {"required": ["environment"]},
            {"required": ["exercises"]},
            {"required": ["proofSurface"]},
            {"required": ["canObserve"]},
            {"required": ["doesNotCover"]},
            {"required": ["claimCeiling"]}
          ]
        }
      }
    }
  ],
  "additionalProperties": true
}
