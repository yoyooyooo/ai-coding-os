{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Coding OS Semantic Vocabulary",
  "type": "object",
  "required": [
    "schema_version",
    "syntax",
    "terms"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "syntax": {
      "type": "object"
    },
    "terms": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "category",
          "owner",
          "means"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "means": {
            "type": "string"
          },
          "does_not_mean": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "qualifiers": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
