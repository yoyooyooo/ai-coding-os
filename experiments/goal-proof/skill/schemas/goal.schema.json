{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goal Proof Goal Contract v2",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "status",
    "objective",
    "completion",
    "claim_limit",
    "agent_authority"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "minLength": 1},
    "status": {"enum": ["forming", "ready", "running", "blocked", "done", "retired"]},
    "intent": {"type": "object"},
    "objective": {"type": "string", "minLength": 1},
    "guiding_principle": {"type": "string"},
    "relations": {"type": "object"},
    "authority_refs": {"type": "array", "items": {"type": "string"}},
    "engineering_guidance": {"type": "object"},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "completion": {
      "type": "object",
      "required": ["signal", "required_evidence"],
      "properties": {
        "signal": {"type": "string", "minLength": 1},
        "required_evidence": {
          "description": "Writers use a non-empty array. A scalar remains reader-compatible for existing Goal Packs.",
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            {
              "type": "string",
              "minLength": 1,
              "deprecated": true
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "claim_limit": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "required": ["may_claim", "must_not_claim"],
          "properties": {
            "may_claim": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "must_not_claim": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          },
          "additionalProperties": false
        }
      ]
    },
    "stop_rules": {"type": "array", "items": {"type": "string"}},
    "agent_authority": {
      "type": "object",
      "required": ["continue_by_default", "requires_human_decision", "agent_may_revise"],
      "properties": {
        "continue_by_default": {"type": "boolean"},
        "requires_human_decision": {"type": "array", "items": {"type": "string"}},
        "agent_may_revise": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "evidence_mode": {"enum": ["light", "normal", "strict"]}
  },
  "additionalProperties": true
}
